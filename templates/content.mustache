{{!
    @template block_oksigeniaaravo/content

    The card of the block: the bag, this month's included intervention and the last three works, read from the central.

    Example context (json):
    {
        "updated": "Updated at 4 Nov, 09:12",
        "failed": false,
        "bag": {
            "remaining": "3 h 45 min",
            "summary": "6 h 15 min used of 10 h",
            "percent": 37,
            "low": false,
            "numberclass": "",
            "barclass": "bg-success"
        },
        "interventions": {"text": "Included intervention (November 2026): available", "tone": "text-success"},
        "hasrecent": true,
        "recent": [
            {"date": "4 November 2026", "description": "Added 12 users", "minutes": "30 min", "type": "From the bag", "typetone": "text-primary"}
        ],
        "registerurl": "https://example.com/blocks/oksigeniaaravo/index.php"
    }
}}
<div class="block-oksigeniaaravo">
    {{#empty}}
        <p class="text-muted mb-0">{{message}}</p>
    {{/empty}}
    {{^empty}}
        {{#failed}}
            <p class="small text-muted mb-2">{{#str}} couldnotupdate, block_oksigeniaaravo {{/str}}</p>
        {{/failed}}
        {{#bag}}
            <div class="aravo-bag mb-3">
                <div class="aravo-label text-muted">{{#str}} bagtitle, block_oksigeniaaravo {{/str}}</div>
                <div class="aravo-remaining {{numberclass}}">{{remaining}}</div>
                <div class="progress aravo-progress my-1" role="progressbar" aria-label="{{#str}} bagtitle, block_oksigeniaaravo {{/str}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar {{barclass}}" style="width: {{percent}}%;"></div>
                </div>
                <div class="small text-muted">{{summary}}</div>
            </div>
        {{/bag}}
        {{#interventions}}
            <div class="aravo-intervention mb-3"><span class="aravo-chip {{tone}}">{{text}}</span></div>
        {{/interventions}}
        {{#hasrecent}}
            <div class="aravo-label text-muted">{{#str}} recenttitle, block_oksigeniaaravo {{/str}}</div>
            <ul class="aravo-worklist list-unstyled mb-3">
                {{#recent}}
                    <li class="aravo-work">
                        <div class="aravo-work-main">{{description}}</div>
                        <div class="small text-muted">{{date}} · {{minutes}} · <span class="{{typetone}}">{{type}}</span></div>
                    </li>
                {{/recent}}
            </ul>
        {{/hasrecent}}
        <a class="aravo-more" href="{{registerurl}}">{{#str}} fullregister, block_oksigeniaaravo {{/str}} →</a>
        {{#updated}}
            <div class="small text-muted mt-2">{{updated}}</div>
        {{/updated}}
    {{/empty}}
</div>
