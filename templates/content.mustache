{{!
    @template block_oksigeniaaravo/content

    The card of the block: the bag, this month's included intervention and the last three works, read from the central.

    Example context (json):
    {
        "brand": "Oksigenia support",
        "updated": "Updated on 4 November 2026 at 09:12",
        "failed": false,
        "bag": {
            "remaining": "3 h 30 min",
            "line": "3 h 30 min left of 10 h · 6 h 30 min used",
            "percent": 35,
            "numberclass": "",
            "barclass": "bg-warning",
            "statusword": "Low balance"
        },
        "interventionline": "Interventions for November 2026: 1 of 2",
        "usage": {"rows": [{"label": "Active users (30 days)", "text": "120 of 200", "percent": 60, "barclass": ""}]},
        "hasrecent": true,
        "recent": [
            {"date": "4 November 2026", "description": "Added 12 users", "minutes": "30 min", "type": "From the bag", "typedot": "text-primary"}
        ],
        "registerurl": "https://example.com/blocks/oksigeniaaravo/index.php"
    }
}}
<div class="block-oksigeniaaravo">
    {{#empty}}
        <p class="text-muted mb-0">{{message}}</p>
    {{/empty}}
    {{^empty}}
        {{#failed}}
            <p class="small text-muted mb-2">{{#str}} couldnotupdate, block_oksigeniaaravo {{/str}}</p>
        {{/failed}}
        {{#bag}}
            <div class="aravo-bag mb-3">
                <div class="aravo-label text-muted">{{#str}} bagtitle, block_oksigeniaaravo {{/str}}</div>
                <div class="aravo-figurerow">
                    <span class="aravo-remaining {{numberclass}}">{{remaining}}</span>
                    {{#statusword}}<span class="aravo-status">{{statusword}}</span>{{/statusword}}
                </div>
                <div class="progress aravo-progress my-1" role="progressbar" aria-label="{{#str}} bagtitle, block_oksigeniaaravo {{/str}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100" aria-valuetext="{{line}}">
                    <div class="progress-bar {{barclass}}" style="width: {{percent}}%;"></div>
                </div>
                <div class="small text-muted">{{line}}</div>
            </div>
        {{/bag}}
        {{#included}}
            <p class="aravo-included mb-3">{{#str}} includedtitle, block_oksigeniaaravo {{/str}} · <span class="aravo-includedval text-success">{{.}}</span></p>
        {{/included}}
        {{#interventionline}}
            <p class="aravo-intervention mb-3">{{.}}</p>
        {{/interventionline}}
        {{#usage}}
            <div class="aravo-usage mb-3">
                <div class="aravo-label text-muted">{{#str}} usagetitle, block_oksigeniaaravo {{/str}}</div>
                {{#rows}}
                    <div class="aravo-usagerow">
                        <div class="small d-flex justify-content-between"><span>{{label}}</span><span class="text-muted">{{text}}</span></div>
                        <div class="progress aravo-progress" role="progressbar" aria-label="{{label}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100" aria-valuetext="{{text}}">
                            <div class="progress-bar {{barclass}}" style="width: {{percent}}%;"></div>
                        </div>
                    </div>
                {{/rows}}
            </div>
        {{/usage}}
        {{#hasrecent}}
            <div class="aravo-label text-muted">{{#str}} recenttitle, block_oksigeniaaravo {{/str}}</div>
            <ul class="aravo-worklist list-unstyled mb-3">
                {{#recent}}
                    <li class="aravo-work">
                        <div class="aravo-work-main">{{description}}</div>
                        <div class="small text-muted">{{date}} · {{minutes}} · <span class="aravo-dot {{typedot}}" aria-hidden="true">●</span> {{type}}</div>
                    </li>
                {{/recent}}
            </ul>
        {{/hasrecent}}
        <a class="aravo-more" href="{{registerurl}}">{{#str}} fullregister, block_oksigeniaaravo {{/str}} →</a>
        <div class="small text-muted mt-2">{{#brand}}{{brand}} · {{/brand}}{{updated}}</div>
    {{/empty}}
</div>
