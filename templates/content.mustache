{{!
    @template block_oksigeniaaravo/content

    The card of the block: the bag as a ring (with the ñandutí lace of the emblem inside), the month's included
    interventions as pips, the plan usage as half-moon gauges, a subtitle and Oksigenia in sight. The SVGs are inline
    (no CDN) and take their colours from the theme variables, so they read in light, in dark and with each client's
    brand. The card folds to a compact summary; that behaviour is added by the block's inline AMD module.

    Example context (json):
    {
        "subtitle": "The support time spent on your services · only the management sees it",
        "notice": {"label": "Sample", "text": "Sample data: on your platform you will see the real hours and work of your contract."},
        "brand": "Oksigenia support",
        "updated": "Updated on 4 November 2026 at 09:12",
        "failed": false,
        "bag": {
            "remainingmain": "3 h", "remainingrest": "30 min", "of": "of 10 h",
            "line": "3 h 30 min left of 10 h · 6 h 30 min used",
            "percent": 35, "state": "low", "statusword": "Low balance"
        },
        "gifts": {
            "two": true,
            "courtesy": {"total": "1 h 30 min", "period": "Since 1 July 2026", "latest": "One-hour training for the team"},
            "included": {"total": "4 h", "period": "Since 1 July 2026", "month": "1 h 30 min", "hasparts": true,
                "parts": [{"label": "Plan maintenance", "text": "2 h 30 min", "minutes": 150, "kind": "maintenance"},
                          {"label": "Included interventions", "text": "1 h 30 min", "minutes": 90, "kind": "intervention"}]}
        },
        "intervention": {"label": "Interventions for November 2026", "text": "1 of 2",
                         "pips": [{"used": true}, {"used": false}]},
        "usage": {"rows": [{"label": "Active users (30 days)", "text": "120 of 200", "percent": 60, "percenttext": "60%", "state": ""}]},
        "hasrecent": true,
        "recent": [{"date": "4 November 2026", "description": "Added 12 users", "minutes": "30 min", "type": "From the bag", "typedot": "text-primary"}],
        "registerurl": "https://example.com/blocks/oksigeniaaravo/index.php"
    }
}}
<div class="block-oksigeniaaravo"{{^empty}} data-aravo-summary="{{summaryline}}" data-aravo-intro="{{#str}} cardintro, block_oksigeniaaravo {{/str}}"{{/empty}}>
    {{#empty}}
        <p class="text-muted mb-0">{{message}}</p>
    {{/empty}}
    {{^empty}}
    {{#subtitle}}
        <p class="aravo-subtitle">{{.}}</p>
    {{/subtitle}}
    {{#notice}}
        <p class="aravo-notice">{{#label}}<span class="aravo-notice-tag">{{label}}</span> {{/label}}{{text}}</p>
    {{/notice}}
    <div class="aravo-detail">
        {{#failed}}
            <p class="small text-muted mb-2">{{#str}} couldnotupdate, block_oksigeniaaravo {{/str}}</p>
        {{/failed}}
        {{#bag}}
            <section class="aravo-bag aravo-is-{{state}}{{#gifts}} aravo-bag-has-gifts{{/gifts}}" aria-label="{{#str}} bagtitle, block_oksigeniaaravo {{/str}}">
                <div class="aravo-ring">
                    <svg viewBox="0 0 120 120" role="img" aria-label="{{line}}" focusable="false">
                        <g class="aravo-lace" aria-hidden="true">
                            <path class="aravo-lace-threads" d="M60 30L60 17M75 34L81.5 22.8M86 45L97.2 38.5M90 60L103 60M86 75L97.2 81.5M75 86L81.5 97.2M60 90L60 103M45 86L38.5 97.2M34 75L22.8 81.5M30 60L17 60M34 45L22.8 38.5M45 34L38.5 22.8"/>
                            <path class="aravo-lace-web" d="M60 24Q70.8 19.7 78 28.8M78 28.8Q89.5 30.5 91.2 42M91.2 42Q100.3 49.2 96 60M96 60Q100.3 70.8 91.2 78M91.2 78Q89.5 89.5 78 91.2M78 91.2Q70.8 100.3 60 96M60 96Q49.2 100.3 42 91.2M42 91.2Q30.5 89.5 28.8 78M28.8 78Q19.7 70.8 24 60M24 60Q19.7 49.2 28.8 42M28.8 42Q30.5 30.5 42 28.8M42 28.8Q49.2 19.7 60 24"/>
                        </g>
                        <path class="aravo-ring-track" d="M60 8A52 52 0 0 1 60 112A52 52 0 0 1 60 8" pathLength="100"/>
                        <path class="aravo-ring-value" d="M60 8A52 52 0 0 1 60 112A52 52 0 0 1 60 8" pathLength="100" stroke-dasharray="{{percent}} 200"/>
                    </svg>
                    <div class="aravo-ring-centre" aria-hidden="true">
                        <span class="aravo-remaining">{{remainingmain}}</span>
                        {{#remainingrest}}<span class="aravo-remaining-rest">{{.}}</span>{{/remainingrest}}
                        <span class="aravo-ring-of">{{of}}</span>
                    </div>
                </div>
                <div class="aravo-bag-facts">
                    <div class="aravo-label">{{#str}} bagtitle, block_oksigeniaaravo {{/str}}{{#bagtip}} {{> core/help_icon }}{{/bagtip}}</div>
                    {{#statusword}}<span class="aravo-status">{{statusword}}</span>{{/statusword}}
                    <p class="aravo-line">{{line}}</p>
                    {{#intervention}}
                        <p class="aravo-intervention">
                            <span class="aravo-pips" aria-hidden="true">{{#pips}}<span class="aravo-pip{{#used}} is-used{{/used}}"></span>{{/pips}}</span>
                            <span>{{label}}: <strong>{{text}}</strong></span>
                        </p>
                    {{/intervention}}
                </div>
                {{#gifts}}
                    <div class="aravo-gifts{{#two}} aravo-gifts-two{{/two}}">
                        {{#courtesy}}
                            <section class="aravo-gift aravo-courtesy" aria-label="{{#str}} courtesytitle, block_oksigeniaaravo {{/str}}: {{total}}, {{period}}">
                                <div class="aravo-label">
                                    <svg class="aravo-spark" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0.8C8.6 5.2 10.8 7.4 15.2 8C10.8 8.6 8.6 10.8 8 15.2C7.4 10.8 5.2 8.6 0.8 8C5.2 7.4 7.4 5.2 8 0.8Z"/></svg>
                                    {{#str}} courtesytitle, block_oksigeniaaravo {{/str}}
                                </div>
                                <p class="aravo-gift-total">{{total}}</p>
                                <p class="aravo-gift-period">{{period}}<br>{{#str}} courtesynote, block_oksigeniaaravo {{/str}}</p>
                                {{#latest}}
                                    <p class="aravo-gift-latest">{{#str}} courtesylatest, block_oksigeniaaravo {{/str}}: {{.}}</p>
                                {{/latest}}
                            </section>
                        {{/courtesy}}
                        {{#included}}
                            <section class="aravo-gift aravo-included-card" aria-label="{{#str}} includedtitle, block_oksigeniaaravo {{/str}}: {{total}}, {{period}}">
                                <div class="aravo-label"><span class="aravo-tick" aria-hidden="true"></span>{{#str}} includedtitle, block_oksigeniaaravo {{/str}}</div>
                                <p class="aravo-gift-total">{{total}}</p>
                                <p class="aravo-gift-period">{{period}}<br>{{#str}} includednotbag, block_oksigeniaaravo {{/str}}</p>
                                {{#hasparts}}
                                    <div class="aravo-included-bar" aria-hidden="true">
                                        {{#parts}}<span class="aravo-included-seg aravo-kind-{{kind}}" style="flex-grow: {{minutes}};"></span>{{/parts}}
                                    </div>
                                {{/hasparts}}
                                <ul class="aravo-included-parts list-unstyled">
                                    {{#parts}}
                                        <li><span class="aravo-included-key aravo-kind-{{kind}}" aria-hidden="true"></span><span class="aravo-included-name">{{label}}</span> <strong>{{text}}</strong></li>
                                    {{/parts}}
                                </ul>
                                {{#month}}
                                    <p class="aravo-included-month"><span class="aravo-included-name">{{#str}} includedmonth, block_oksigeniaaravo {{/str}}</span> <strong>{{.}}</strong></p>
                                {{/month}}
                            </section>
                        {{/included}}
                    </div>
                {{/gifts}}
            </section>
        {{/bag}}
        {{#usage}}
            <section class="aravo-usage" aria-label="{{#str}} usagetitle, block_oksigeniaaravo {{/str}}">
                <div class="aravo-label">{{#str}} usagetitle, block_oksigeniaaravo {{/str}}</div>
                <div class="aravo-gauges">
                    {{#rows}}
                        <figure class="aravo-gauge aravo-is-{{state}}">
                            <svg viewBox="0 0 120 66" role="img" aria-label="{{label}}: {{text}}" focusable="false">
                                <path class="aravo-gauge-track" d="M10 60A50 50 0 0 1 110 60" pathLength="100"/>
                                <path class="aravo-gauge-value" d="M10 60A50 50 0 0 1 110 60" pathLength="100" stroke-dasharray="{{percent}} 200"/>
                            </svg>
                            <div class="aravo-gauge-number" aria-hidden="true">{{percenttext}}</div>
                            <figcaption>
                                <span class="aravo-gauge-label">{{label}}</span>
                                <span class="aravo-gauge-text">{{text}}</span>
                            </figcaption>
                        </figure>
                    {{/rows}}
                </div>
            </section>
        {{/usage}}
        {{#hasrecent}}
            <div class="aravo-label">{{#str}} recenttitle, block_oksigeniaaravo {{/str}}</div>
            <ul class="aravo-worklist list-unstyled">
                {{#recent}}
                    <li class="aravo-work">
                        <div class="aravo-work-main">{{description}}</div>
                        <div class="aravo-work-meta">{{date}} · {{minutes}} · <span class="aravo-type"><span class="aravo-dot {{typedot}}" aria-hidden="true"></span>{{type}}</span></div>
                    </li>
                {{/recent}}
            </ul>
        {{/hasrecent}}
        <a class="aravo-more" href="{{registerurl}}">{{#str}} fullregister, block_oksigeniaaravo {{/str}} →</a>
        <p class="aravo-sign"><span class="aravo-oks" aria-hidden="true"></span>{{#brand}}<span class="aravo-brand">{{brand}}</span> · {{/brand}}{{updated}}</p>
    </div>
    {{/empty}}
</div>
