{{!
    @template block_oksigeniaaravo/register

    The full register: the bag, this month's intervention, the per-month summary and the work log, with the download.

    Example context (json):
    {
        "updated": "Updated at 4 Nov, 09:12",
        "failed": false,
        "bag": {"remaining": "3 h 45 min", "summary": "6 h 15 min used of 10 h", "percent": 37, "low": false},
        "interventions": "Included intervention (November 2026): available",
        "hassummary": true,
        "summary": [
            {"month": "November 2026", "interventions": "0 of 1", "bag": "0 min", "outofbag": "0 min", "maintenance": "1 h"}
        ],
        "hasentries": true,
        "entries": [
            {"date": "4 November 2026", "description": "Added 12 users", "minutes": "30 min", "type": "Included intervention"}
        ],
        "downloadcsv": "https://example.com/blocks/oksigeniaaravo/index.php?dataformat=csv",
        "downloadexcel": "https://example.com/blocks/oksigeniaaravo/index.php?dataformat=excel"
    }
}}
<div class="block-oksigeniaaravo-register">
    {{#failed}}
        <div class="alert alert-warning">{{#str}} couldnotupdate, block_oksigeniaaravo {{/str}}</div>
    {{/failed}}
    {{#bag}}
        <div class="aravo-bag mb-3">
            <h3>{{#str}} bagtitle, block_oksigeniaaravo {{/str}}</h3>
            <p class="aravo-remaining h4 {{#low}}text-danger{{/low}}">{{remaining}}</p>
            <div class="progress aravo-progress" role="progressbar" aria-label="{{#str}} bagtitle, block_oksigeniaaravo {{/str}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: {{percent}}%;"></div>
            </div>
            <p class="small text-muted">{{summary}}</p>
        </div>
    {{/bag}}
    {{#interventions}}
        <p class="aravo-intervention mb-3">{{.}}</p>
    {{/interventions}}
    {{#hassummary}}
        <h3>{{#str}} summarytitle, block_oksigeniaaravo {{/str}}</h3>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col">{{#str}} colmonth, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} colinterventions, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} colbag, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} coloutofbag, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} colmaintenance, block_oksigeniaaravo {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#summary}}
                    <tr><td>{{month}}</td><td>{{interventions}}</td><td>{{bag}}</td><td>{{outofbag}}</td><td>{{maintenance}}</td></tr>
                {{/summary}}
            </tbody>
        </table>
    {{/hassummary}}
    {{#hasentries}}
        <h3>{{#str}} worktitle, block_oksigeniaaravo {{/str}}</h3>
        <p>
            <a class="btn btn-secondary btn-sm" href="{{downloadcsv}}">{{#str}} downloadcsv, block_oksigeniaaravo {{/str}}</a>
            <a class="btn btn-secondary btn-sm" href="{{downloadexcel}}">{{#str}} downloadexcel, block_oksigeniaaravo {{/str}}</a>
        </p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col">{{#str}} coldate, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} coldescription, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} colminutes, block_oksigeniaaravo {{/str}}</th>
                    <th scope="col">{{#str}} coltype, block_oksigeniaaravo {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#entries}}
                    <tr><td>{{date}}</td><td>{{description}}</td><td>{{minutes}}</td><td>{{type}}</td></tr>
                {{/entries}}
            </tbody>
        </table>
    {{/hasentries}}
    {{#centraladminurl}}
        <p><a href="{{centraladminurl}}">{{#str}} centraladmin, block_oksigeniaaravo {{/str}}</a></p>
    {{/centraladminurl}}
    {{#updated}}
        <p class="small text-muted">{{updated}}</p>
    {{/updated}}
</div>
