{{!
    @template block_oksigeniaaravo/register

    The full register: the bag, this month's interventions, the per-month summary and the work log, with the download.

    Example context (json):
    {
        "brand": "Oksigenia support",
        "updated": "Updated on 4 November 2026 at 09:12",
        "failed": false,
        "notice": {"label": "Sample", "text": "Sample data: on your platform you will see the real hours and work of your contract."},
        "bag": {"remaining": "3 h 30 min", "line": "3 h 30 min left of 10 h · 6 h 30 min used", "percent": 35, "numberclass": "", "barclass": "bg-warning", "statusword": "Low balance"},
        "intervention": {"label": "Included interventions · November 2026", "count": "1 of 2", "segments": [{"filled": true}, {"filled": false}]},
        "usage": {"rows": [{"label": "Active users (30 days)", "text": "120 of 200", "percent": 60, "barclass": ""}, {"label": "Disk", "text": "3.2 GB of 15 GB", "percent": 21, "barclass": ""}]},
        "hassummary": true,
        "summary": [
            {"month": "November 2026", "interventions": "1 of 2", "bag": "30 min", "outofbag": "0 min", "maintenance": "0 min"}
        ],
        "hasentries": true,
        "entries": [
            {"date": "4 November 2026", "description": "Added 12 users", "minutes": "30 min", "type": "From the bag", "typedot": "text-primary"}
        ],
        "downloadform": "<form>…</form>"
    }
}}
<div class="block-oksigeniaaravo-register">
    {{#notice}}
        <p class="aravo-notice">{{#label}}<span class="aravo-notice-tag">{{label}}</span> {{/label}}{{text}}</p>
    {{/notice}}
    {{#failed}}
        <div class="alert alert-warning">{{#str}} couldnotupdate, block_oksigeniaaravo {{/str}}</div>
    {{/failed}}
    <div class="aravo-cards mb-4">
        {{#bag}}
            <div class="aravo-card">
                <h3 class="aravo-label text-muted">{{#str}} bagtitle, block_oksigeniaaravo {{/str}}</h3>
                <div class="aravo-figurerow">
                    <span class="aravo-remaining {{numberclass}}">{{remaining}}</span>
                    {{#statusword}}<span class="aravo-status">{{statusword}}</span>{{/statusword}}
                </div>
                <div class="progress aravo-progress my-2" role="progressbar" aria-label="{{#str}} bagtitle, block_oksigeniaaravo {{/str}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100" aria-valuetext="{{line}}">
                    <div class="progress-bar {{barclass}}" style="width: {{percent}}%;"></div>
                </div>
                <div class="small text-muted">{{line}}</div>
            </div>
        {{/bag}}
        {{#intervention}}
            <div class="aravo-card">
                <h3 class="aravo-label text-muted">{{label}}</h3>
                <div class="aravo-remaining">{{count}}</div>
                <div class="aravo-segments text-primary mt-2">
                    {{#segments}}<span class="aravo-seg {{#filled}}filled{{/filled}}"></span>{{/segments}}
                </div>
            </div>
        {{/intervention}}
        {{#included}}
            <div class="aravo-card">
                <h3 class="aravo-label text-muted">{{#str}} includedtitle, block_oksigeniaaravo {{/str}}</h3>
                <div class="aravo-remaining text-success">{{.}}</div>
            </div>
        {{/included}}
    </div>
    {{#usage}}
        <h2 class="aravo-label text-muted">{{#str}} usagetitle, block_oksigeniaaravo {{/str}}</h2>
        <div class="aravo-usage mb-4">
            {{#rows}}
                <div class="aravo-usagerow">
                    <div class="small d-flex justify-content-between"><span>{{label}}</span><span class="text-muted">{{text}}</span></div>
                    <div class="progress aravo-progress" role="progressbar" aria-label="{{label}}" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100" aria-valuetext="{{text}}">
                        <div class="progress-bar {{barclass}}" style="width: {{percent}}%;"></div>
                    </div>
                </div>
            {{/rows}}
        </div>
    {{/usage}}
    {{#hassummary}}
        <h2 class="aravo-label text-muted">{{#str}} summarytitle, block_oksigeniaaravo {{/str}}</h2>
        <div class="table-responsive mb-4">
            <table class="table table-sm aravo-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} colmonth, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col">{{#str}} colinterventions, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col" class="aravo-num">{{#str}} colbag, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col" class="aravo-num">{{#str}} coloutofbag, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col" class="aravo-num">{{#str}} colmaintenance, block_oksigeniaaravo {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#summary}}
                        <tr>
                            <td data-label="{{#str}} colmonth, block_oksigeniaaravo {{/str}}">{{month}}</td>
                            <td data-label="{{#str}} colinterventions, block_oksigeniaaravo {{/str}}">{{interventions}}</td>
                            <td class="aravo-num" data-label="{{#str}} colbag, block_oksigeniaaravo {{/str}}">{{bag}}</td>
                            <td class="aravo-num" data-label="{{#str}} coloutofbag, block_oksigeniaaravo {{/str}}">{{outofbag}}</td>
                            <td class="aravo-num" data-label="{{#str}} colmaintenance, block_oksigeniaaravo {{/str}}">{{maintenance}}</td>
                        </tr>
                    {{/summary}}
                </tbody>
            </table>
        </div>
    {{/hassummary}}
    {{#hasentries}}
        <div class="aravo-worktop d-flex flex-wrap justify-content-between align-items-center mb-2">
            <h2 class="aravo-label text-muted mb-0">{{#str}} worktitle, block_oksigeniaaravo {{/str}}</h2>
            <div class="aravo-downloads">{{{downloadform}}}</div>
        </div>
        <div class="table-responsive">
            <table class="table aravo-table aravo-worklog mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} coldate, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col">{{#str}} coldescription, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col" class="aravo-num">{{#str}} colminutes, block_oksigeniaaravo {{/str}}</th>
                        <th scope="col">{{#str}} coltype, block_oksigeniaaravo {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#entries}}
                        <tr>
                            <td class="text-nowrap" data-label="{{#str}} coldate, block_oksigeniaaravo {{/str}}">{{date}}</td>
                            <td data-label="{{#str}} coldescription, block_oksigeniaaravo {{/str}}">{{description}}</td>
                            <td class="aravo-num" data-label="{{#str}} colminutes, block_oksigeniaaravo {{/str}}">{{minutes}}</td>
                            <td data-label="{{#str}} coltype, block_oksigeniaaravo {{/str}}"><span class="aravo-dot {{typedot}}" aria-hidden="true">●</span> {{type}}</td>
                        </tr>
                    {{/entries}}
                </tbody>
            </table>
        </div>
    {{/hasentries}}
    {{#centraladminurl}}
        <p class="mt-3"><a href="{{centraladminurl}}">{{#str}} centraladmin, block_oksigeniaaravo {{/str}}</a></p>
    {{/centraladminurl}}
    <p class="small text-muted mt-2">{{#brand}}{{brand}} · {{/brand}}{{updated}}</p>
</div>
